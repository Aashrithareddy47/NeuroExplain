# NeuroExplain Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Google Gemini API Key (Required for grounded LLM explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30

# Multilingual Embeddings & Vector DB
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=faiss_index

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Temporary file storage cleanup interval (minutes)
TEMP_FILE_EXPIRY_MINUTES=30
